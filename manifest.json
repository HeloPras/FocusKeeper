{
  "manifest_version": 3,
  "name": "FocusKeeper",
  "version": "1.2.0",
  "description": "Track time on distracting sites, plan daily tasks and get honest feedback about your focus.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": { "default_title": "Open FocusKeeper" },
  "background": { "service_worker": "src/background/background.ts" },
  "side_panel": { "default_path": "src/pages/sidepanel/index.html" },
  "permissions": ["tabs", "storage", "idle", "alarms", "notifications", "sidePanel"]
}
